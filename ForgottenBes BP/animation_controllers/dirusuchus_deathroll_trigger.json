{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.dirusuchus.deathroll_trigger": {
      "initial_state": "not_rolling",
      "states": {
        "not_rolling": {
          "transitions": [
            { "rolling": "query.is_in_water&&query.has_rider" }
          ]
        },
        "rolling": {
          "on_entry": [ "@s diru:try_start_roll" ],
          "on_exit": [ "@s diru:stop_roll_only" ],
          "transitions": [
            { "not_rolling": "!query.is_in_water||!query.has_rider" }
          ]
        }
      }
    }
  }
}