{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.dirusuchus.deathroll": {
      "initial_state": "default",
      "states": {
        "default": {
          "transitions": [
            { "have_target_rider": "query.has_target&&query.is_saddled" }
          ],
          "on_entry": [ "@s diru:deathroll_re_event" ]
        },
        "have_target_rider": {
          "on_entry": [
            "/ride @e[r=5,type=!si:dirusuchus,c=1] start_riding @s teleport_rider"
          ],
          "transitions": [
            { "have_rider_repeat": "!query.has_rider" },
            { "default": "!query.has_rider" }
          ]
        },
        "have_rider_repeat": {
          "on_entry": [
            "/ride @e[r=5,type=!si:dirusuchus,c=1] start_riding @s teleport_rider"
          ],
          "transitions": [
            { "have_target_rider": "!query.has_rider" },
            { "default": "!query.has_rider" }
          ]
        }
      }
    }
  }
}