        "events": {
            "diru:underwater_event": { "add": { "component_groups": ["diru:underwater"] } },
            "diru:ground_event": { "remove": { "component_groups": ["diru:underwater"] } },
            "minecraft:start_sitting": {
                "add": { "component_groups": ["diru:sitting"] },
                "remove": { "component_groups": ["diru:standing"] }
            },
            "minecraft:stop_sitting": {
                "add": { "component_groups": ["diru:standing"] },
                "remove": { "component_groups": ["diru:sitting"] }
            },
            "diru:pred_lost": {
                "queue_command": { "command": "scriptevent diru:pred_lost" },
                "remove": { "component_groups": ["diru:prepare_to_deathroll", "diru:carry", "diru:deathroll"] }
            },
            "diru:prepare_to_deathroll_add": {
                "add": { "component_groups": ["diru:prepare_to_deathroll"] }
            },
            "diru:grab_event": {
                "add": { "component_groups": ["diru:carry"] },
                "remove": { "component_groups": ["diru:prepare_to_deathroll"] }
            },
            "diru:try_start_roll": {
                "add": { "component_groups": ["diru:deathroll"] }
            },
            "diru:stop_roll_only": {
                "remove": { "component_groups": ["diru:deathroll"] }
            },
            "diru:deathroll_re_event": {
                "remove": { "component_groups": ["diru:carry", "diru:deathroll"] },
                "add": { "component_groups": ["diru:prepare_to_deathroll"] }
            },
            "diru:land_damage_event": {
                "queue_command": {
                    "command": "damage @e[r=3,type=!si:dirusuchus,c=1] 3 entity_attack"
                }
            },
            "diru:damage_event": {
                "queue_command": {
                    "command": "damage @e[r=3,type=!si:dirusuchus,c=1] 5 entity_attack"
                }
            },
            "diru:deathroll_exit_chance_event": {
                "randomize": [
                    { "weight": 2 },
                    { "weight": 1, "trigger": "diru:deathroll_re_event" }
                ]
            },
            "minecraft:entity_spawned": {
                "sequence": [
                    {
                        "randomize": [
                            { "weight": 95, "add": { "component_groups": ["diru_default"] } },
                            { "weight": 5, "add": { "component_groups": ["diru_muted"] } }
                        ]
                    },
